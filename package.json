{
  "name": "holdslot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "node --test test/",
    "verify:sandbox": "node --env-file=.env scripts/verify-sandbox.mjs",
    "cf:build": "NEXT_PRIVATE_STANDALONE=true NEXT_PRIVATE_OUTPUT_TRACE_ROOT=. next build && opennextjs-cloudflare build --skipNextBuild",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "db:migrate": "wrangler d1 execute holdslot --remote --file db/schema.sql",
    "db:migrate:local": "wrangler d1 execute holdslot --local --file db/schema.sql"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.7",
    "@bryntum/scheduler-react": "^7.3.7",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}