# Copy to .env and fill in. Never commit .env.

# PayPal sandbox: developer.paypal.com → Apps & Credentials (Sandbox) → the HoldSlot app
# (Merchant app on a US sandbox business account, with Vault enabled)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled after registering the webhook for <APP_URL>/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Claude: booking receptionist and policy reader
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Public origin of the app (PayPal returns clients here after approving)
APP_URL=http://localhost:3000
# Cookie signing secret (openssl rand -hex 32)
SESSION_SECRET=
# Owner sign-in for the calendar, policy and demo controls
OWNER_PASSCODE=
# Optional: a vaulted sandbox PayPal token reused by the seeded demo clients, so judges can
# watch real holds without approving PayPal themselves (see README, "Demo data")
DEMO_VAULT_ID=
# Shared secret the Cloudflare cron trigger sends to /api/sweep (openssl rand -hex 24)
SWEEP_SECRET=
# Cloudflare account Wrangler deploys to
CLOUDFLARE_ACCOUNT_ID=
